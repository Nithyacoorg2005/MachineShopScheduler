{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sridhar Precision Works - Baseline Dataset Schema",
  "type": "object",
  "required": [
    "_metadata",
    "shop_config",
    "machines",
    "changeover_matrix",
    "operators",
    "orders"
  ],
  "properties": {
    "_metadata": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "seed": { "type": "integer" },
        "generated_at": { "type": "string", "format": "date-time" },
        "validation_status": { "type": "string", "enum": ["PASSED", "PENDING", "FAILED"] }
      },
      "required": ["seed", "validation_status"]
    },
    "shop_config": {
      "type": "object",
      "properties": {
        "shifts": {
          "type": "object",
          "patternProperties": {
            "^[A-C]$": {
              "type": "object",
              "properties": {
                "start": { "type": "string" },
                "end": { "type": "string" }
              },
              "required": ["start", "end"]
            }
          }
        },
        "generator_cost_differential": { "type": "number" },
        "overtime_rate_multiplier": { "type": "number" }
      },
      "required": ["shifts", "generator_cost_differential", "overtime_rate_multiplier"]
    },
    "machines": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "properties": {
          "machine_id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["CNC Lathe", "Milling", "Drill", "Grinding"]
          },
          "hourly_cost": { "type": "number", "minimum": 0 },
          "mtbf_hrs": { "type": "number", "minimum": 0 },
          "mttr_hrs": { "type": "number", "minimum": 0 }
        },
        "required": ["machine_id", "type", "hourly_cost", "mtbf_hrs", "mttr_hrs"]
      }
    },
    "changeover_matrix": {
      "type": "object",
      "properties": {
        "SAME_FAMILY_MINS": { "type": "number", "minimum": 0 },
        "CROSS_FAMILY_MINS": { "type": "number", "minimum": 0 },
        "part_families": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "required": ["SAME_FAMILY_MINS", "CROSS_FAMILY_MINS", "part_families"]
    },
    "operators": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "properties": {
          "operator_id": { "type": "string" },
          "name": { "type": "string" },
          "shift": { "type": "string", "enum": ["A", "B", "C"] },
          "certified_machines": {
            "type": "array",
            "items": { "type": "string" }
          },
          "absenteeism_prob": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["operator_id", "shift", "certified_machines"]
      }
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order_id": { "type": "string" },
          "customer_tier": { "type": "string", "enum": ["Tier-1", "Tier-2"] },
          "part_family": { "type": "string" },
          "quantity": {
            "type": "integer",
            "minimum": 200,
            "maximum": 5000
          },
          "due_date": { "type": "string", "format": "date-time" },
          "daily_late_penalty": { "type": "number", "minimum": 0 },
          "unit_margin": { "type": "number", "minimum": 0 },
          "routing": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": {
              "type": "object",
              "properties": {
                "op_seq": { "type": "integer", "minimum": 1 },
                "type": { "type": "string" },
                "time_per_piece_mins": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["op_seq", "type", "time_per_piece_mins"]
            }
          }
        },
        "required": [
          "order_id",
          "customer_tier",
          "part_family",
          "quantity",
          "due_date",
          "daily_late_penalty",
          "routing"
        ]
      }
    }
  }
}