{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sridhar Precision Works - Baseline Dataset Schema",
  "type": "object",
  "required": [
    "_metadata",
    "shop_config",
    "machines",
    "changeover_matrix",
    "operators",
    "orders",
    "breakdown_history"
  ],
  "properties": {
    "_metadata": {
      "type": "object",
      "required": [
        "version",
        "seed",
        "validation_status"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "PASSED",
            "PENDING",
            "FAILED"
          ]
        }
      },
      "additionalProperties": false
    },

    "shop_config": {
      "type": "object",
      "required": [
        "shifts",
        "generator_cost_differential",
        "overtime_rate_multiplier"
      ],
      "properties": {
        "shifts": {
          "type": "object",
          "required": [
            "A",
            "B"
          ],
          "properties": {
            "A": {
              "$ref": "#/$defs/shift"
            },
            "B": {
              "$ref": "#/$defs/shift"
            }
          },
          "additionalProperties": false
        },
        "generator_cost_differential": {
          "type": "number",
          "minimum": 0
        },
        "overtime_rate_multiplier": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },

    "machines": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": [
          "machine_id",
          "type",
          "hourly_cost",
          "mtbf_hrs",
          "mttr_hrs",
          "status"
        ],
        "properties": {
          "machine_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "CNC_LATHE",
              "MILLING",
              "DRILL",
              "GRINDING"
            ]
          },
          "hourly_cost": {
            "type": "number",
            "minimum": 0
          },
          "mtbf_hrs": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "mttr_hrs": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "DOWN",
              "MAINTENANCE"
            ]
          }
        },
        "additionalProperties": false
      }
    },

    "changeover_matrix": {
      "type": "object",
      "required": [
        "matrix",
        "part_families"
      ],
      "properties": {
        "matrix": {
          "type": "object",
          "required": [
            "FAM_A",
            "FAM_B",
            "FAM_C",
            "FAM_D"
          ],
          "properties": {
            "FAM_A": {
              "$ref": "#/$defs/changeoverRow"
            },
            "FAM_B": {
              "$ref": "#/$defs/changeoverRow"
            },
            "FAM_C": {
              "$ref": "#/$defs/changeoverRow"
            },
            "FAM_D": {
              "$ref": "#/$defs/changeoverRow"
            }
          },
          "additionalProperties": false
        },
        "part_families": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "FAM_A",
              "FAM_B",
              "FAM_C",
              "FAM_D"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },

    "operators": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "operator_id",
          "name",
          "shift",
          "certified_machines",
          "absenteeism_prob"
        ],
        "properties": {
          "operator_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "shift": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "certified_machines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "absenteeism_prob": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },

    "orders": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": [
          "order_id",
          "customer_tier",
          "part_family",
          "quantity",
          "due_date",
          "daily_late_penalty",
          "unit_margin",
          "routing"
        ],
        "properties": {
          "order_id": {
            "type": "string"
          },
          "customer_tier": {
            "type": "string",
            "enum": [
              "Tier-1",
              "Tier-2"
            ]
          },
          "part_family": {
            "type": "string",
            "enum": [
              "FAM_A",
              "FAM_B",
              "FAM_C",
              "FAM_D"
            ]
          },
          "quantity": {
            "type": "integer",
            "minimum": 200,
            "maximum": 5000
          },
          "due_date": {
            "type": "string",
            "format": "date-time"
          },
          "daily_late_penalty": {
            "type": "number",
            "minimum": 0
          },
          "unit_margin": {
            "type": "number",
            "minimum": 0
          },
          "routing": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": {
              "$ref": "#/$defs/operation"
            }
          }
        },
        "additionalProperties": false
      }
    },

    "breakdown_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "breakdown_id",
          "machine_id",
          "machine_type",
          "duration_hours",
          "cause"
        ],
        "properties": {
          "breakdown_id": {
            "type": "string"
          },
          "machine_id": {
            "type": "string"
          },
          "machine_type": {
            "type": "string",
            "enum": [
              "CNC_LATHE",
              "MILLING",
              "DRILL",
              "GRINDING"
            ]
          },
          "duration_hours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cause": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },

  "$defs": {
    "shift": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      },
      "additionalProperties": false
    },

    "changeoverRow": {
      "type": "object",
      "required": [
        "FAM_A",
        "FAM_B",
        "FAM_C",
        "FAM_D"
      ],
      "properties": {
        "FAM_A": {
          "type": "number",
          "minimum": 0
        },
        "FAM_B": {
          "type": "number",
          "minimum": 0
        },
        "FAM_C": {
          "type": "number",
          "minimum": 0
        },
        "FAM_D": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },

    "operation": {
      "type": "object",
      "required": [
        "op_seq",
        "type",
        "time_per_piece_mins"
      ],
      "properties": {
        "op_seq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "CNC Lathe",
            "Milling",
            "Drill",
            "Grinding",
            "Inspection"
          ]
        },
        "time_per_piece_mins": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}